@@ -40,6 +40,24 @@ import kopf
 import kubernetes

+_exposedapi_cache = {}
+
+
+@kopf.on.event("oda.tmforum.org", "v1", "exposedapis")
+def cache_exposedapi(event, body, **kwargs):
+    key = (body["metadata"]["namespace"], body["metadata"]["name"])
+    if event["type"] == "DELETED":
+        _exposedapi_cache.pop(key, None)
+    else:
+        _exposedapi_cache[key] = body
+
+
+def get_exposedapis_for_component(namespace, component_name):
+    return [b for (ns, _), b in _exposedapi_cache.items()
+            if ns == namespace and b["metadata"].get("labels", {}).get("oda.tmforum.org/componentName") == component_name]
+
+
